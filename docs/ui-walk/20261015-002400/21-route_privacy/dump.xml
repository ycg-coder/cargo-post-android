cted="false" bounds="[88,484][992,1055]" drawing-order="2" hint=""><node index="0" text="一、登录用的信息" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,484][416,550]" drawing-order="0" hint="" /><node index="1" text="手机号与短信验证码：用来建立账号与会话；验证码由平台后端下发与校验。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,567][992,699]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,656][992,788]" drawing-order="2" hint="" /><node index="3" text="昵称、性别、头像：你可以不填，填了可以随时改。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,745][939,811]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,768][992,857]" drawing-order="4" hint="" /><node index="5" text="会话令牌存在本机应用的私有存储里（含刷新令牌与到期时间），用于免重复登录；退出登录或令牌失效即清除。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,857][992,1055]" drawing-order="5" hint="" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1176][992,1925]" drawing-order="3" hint=""><node index="0" text="二、寄件与取件用的信息" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1176][539,1242]" drawing-order="0" hint="" /><node index="1" text="地址簿：你自己新增/修改的收寄地址，存在平台后端，用来算距离与选班次。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1259][992,1391]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1348][992,1437]" drawing-order="2" hint="" /><node index="3" text="运单信息：寄件人与收件人姓名、电话、地址，物品名称、类别、重量、件数，以及目的站点。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1437][992,1569]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1526][992,1615]" drawing-order="4" hint="" /><node index="5" text="货物照片：只有你主动拍并点提交时才上传；提交失败就是失败，不会把没上传成功的照片当成已入库。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1615][992,1747]" drawing-order="5" hint="" /><node index="6" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1704][992,1793]" drawing-order="6" hint="" /><node index="7" text="取件码与签收凭证：用于站点交接与到件核对，只在你的这一单里出现。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1793][992,1925]" drawing-order="7" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,2046][992,2400]" drawing-order="4" hint=""><node index="0" text="三、位置" resource-id="" clas
cted="false" bounds="[88,484][992,877]" drawing-order="2" hint=""><node index="0" text="一、这是什么" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,484][334,550]" drawing-order="0" hint="" /><node index="1" text="乡邮智联：农村客货邮一体化服务，班车顺路带货——快递进村、农产品出山、乘客照常乘车。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,567][992,699]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,656][992,745]" drawing-order="2" hint="" /><node index="3" text="本应用是运输的组织工具：下单、匹配班次、站点交接、跟踪与签收。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,745][992,877]" drawing-order="3" hint="" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,998][992,1813]" drawing-order="3" hint=""><node index="0" text="二、服务边界" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,998][334,1064]" drawing-order="0" hint="" /><node index="1" text="不提供网上预约乘车：班车按线路与时刻运行，逢站必停上下客，你不需要也不能在应用里「订一个座位」。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1081][992,1213]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1170][992,1259]" drawing-order="2" hint="" /><node index="3" text="货物随车不单独占座、不阻塞过道与车门；超限或不符合安全要求的件会被站点退回或改约。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1259][992,1391]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1348][992,1437]" drawing-order="4" hint="" /><node index="5" text="投递方式只有三种：县城内预约上门取件、送到乡镇/村的揽收点或公交站点自提、以及站点之间的交接运输；具体以你下单时页面显示的为准。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1437][992,1635]" drawing-order="5" hint="" /><node index="6" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1592][992,1681]" drawing-order="6" hint="" /><node index="7" text="本应用不是出租车/网约车平台，不做即时点对点派送承诺。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1681][992,1813]" drawing-order="7" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1934][992,2400]" drawing-order="4" hint=""><node index="0" text="三、你的义务" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,1934][334,2000]" drawing-order="0" hint="" /><node index="1" text="填写真实的寄件人、收件人与联系电话；地址不详会导致无法派送时按站点交接处理。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,2017][992,2149]" drawing-order="1" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,2106][992,2195]" drawing-order="2" hint="" /><node index="3" text="不寄递违禁品、危险品与不符合运输规定的物品；生鲜、易碎件请在备注里说明。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,2195][992,2327]" drawing-order="3" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,2284][992,2400]" drawing-order="4" hint="" /><node index="5" text="取件时出示取件码；他人代取的，按站点规则登记。" resource-id="" class="android.widget.TextView" package="com.shanxiang.buspost" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[88,2373][939,2400]" drawing-order="5" hint="" /></node></node></node></node></node></node></node></node></node></hierarchy>